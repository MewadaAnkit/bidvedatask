# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rfq_portal?schema=public"

# Application Ports & Environment
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET="dev-jwt-secret-replace-with-secure-key-in-prod"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# File Upload Volume & Limits
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760
